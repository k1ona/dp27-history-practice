{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dp27.local/schema/sourceset.schema.json",
  "title": "Paper 1 source set: four sources and Q1(a), Q1(b), Q2, Q3, Q4",
  "type": "object",
  "required": ["sourceSetId", "label", "caseStudy", "part", "focus", "sources", "questions"],
  "properties": {
    "sourceSetId": { "type": "string", "pattern": "^P1-CS[12]-[A-Z]+-SS[0-9]{2}$" },
    "label": { "$ref": "common.schema.json#/$defs/label" },
    "caseStudy": { "enum": ["CS1", "CS2"] },
    "part": { "enum": ["causes", "events", "responses"] },
    "focus": { "type": "string", "description": "The aspect of the case study the set addresses" },
    "timedUse": { "type": "boolean", "default": false, "description": "Reserved for a timed full paper; not shown in section practice" },
    "sources": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["letter", "type", "provenance", "verificationRef"],
        "properties": {
          "letter": { "enum": ["A", "B", "C", "D"] },
          "type": { "enum": ["text", "photograph", "cartoon", "poster", "painting", "map", "graph", "table", "diagram"] },
          "provenance": {
            "type": "object", "required": ["creator", "sourceType", "date"],
            "properties": {
              "creator": { "type": "string" }, "sourceType": { "type": "string" }, "date": { "type": "string" },
              "contextNote": { "type": "string" }
            },
            "additionalProperties": false,
            "description": "Candidate-facing only: no URLs, record IDs or licence notes"
          },
          "text": { "type": "string", "description": "Short lawful extract; authentic Paper 1 length" },
          "mediaId": { "$ref": "common.schema.json#/$defs/mediaId" },
          "table": { "type": "object", "required": ["columns", "rows"], "properties": {
            "columns": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "type": ["string", "number"] } } } } },
          "verificationRef": { "type": "string", "description": "Row id in content/_verification/<sectionId>.md holding full provenance, URL, record id and rights" }
        },
        "additionalProperties": false,
        "oneOf": [{ "required": ["text"] }, { "required": ["mediaId"] }, { "required": ["table"] }]
      }
    },
    "questions": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["questionId", "part", "marks", "text", "sources", "model", "selfCheck", "autoCheck"],
        "properties": {
          "questionId": { "type": "string", "pattern": "^P1-CS[12]-[A-Z]+-SS[0-9]{2}-(Q1A|Q1B|Q2|Q3|Q4)$" },
          "part": { "enum": ["p1q1a", "p1q1b", "p1q2", "p1q3", "p1q4"] },
          "marks": { "enum": [3, 2, 4, 6, 9] },
          "text": { "type": "string" },
          "sources": { "type": "array", "minItems": 1, "items": { "enum": ["A", "B", "C", "D"] } },
          "model": {
            "type": "object", "required": ["type"],
            "properties": {
              "type": { "enum": ["points", "band"] },
              "points": { "type": "array", "items": { "type": "string" }, "description": "Q1(a), Q1(b), Q2" },
              "segments": { "type": "array", "items": {
                "type": "object", "required": ["text", "tags"],
                "properties": { "text": { "type": "string" },
                  "tags": { "type": "array", "minItems": 1, "items": { "enum": ["SOURCE", "OWN KNOWLEDGE", "VALUE", "LIMITATION", "COMPARE", "CONTRAST"] } } },
                "additionalProperties": false } },
              "bandNote": { "type": "string", "description": "Which plain-language paraphrase band the model illustrates (Q3, Q4)" }
            },
            "additionalProperties": false
          },
          "selfCheck": { "type": "array", "minItems": 3, "items": { "type": "string" } },
          "autoCheck": { "type": "object", "properties": {
            "expectedPoints": { "type": "integer" },
            "sourceTerms": { "type": "array", "items": { "type": "string" }, "description": "Terms present in the sources; text outside them flags added own knowledge in Q1" },
            "ownKnowledgeLexicon": { "type": "array", "items": { "type": "string" }, "description": "Q4: lexicon terms not present in the sources" },
            "issueKeys": { "type": "array", "items": { "type": "string" }, "description": "Q3: shared issues to compare" }
          } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
